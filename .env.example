# --- Espace admin (/admin) ---
# Mot de passe de l'espace admin. À CHANGER absolument en production.
ADMIN_PASSWORD=change-moi-en-production
# Secret de signature des sessions (>= 32 caractères aléatoires).
SESSION_SECRET=remplace-par-une-chaine-aleatoire-de-32-caracteres-minimum

# --- Stockage des annonces (PRODUCTION Vercel) ---
# Crée un store "KV" / Upstash dans Vercel (Storage > Create) : les variables
# ci-dessous sont ajoutées automatiquement au projet. Sans elles, le site
# utilise un fichier local (OK en dev, NE PERSISTE PAS sur Vercel).
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
#
# ATTENTION : si ces variables pointent vers une base SUPPRIMÉE, le site
# fonctionne mais l'enregistrement des annonces échoue. L'espace /admin
# affiche alors un bandeau d'alerte avec la marche à suivre. Après avoir
# supprimé une base, retire aussi ses variables ou relie-en une nouvelle.

# --- Upload des photos d'annonces (PRODUCTION Vercel) ---
# Crée un store "Blob" dans Vercel (Storage > Create > Blob) : la variable
# ci-dessous est ajoutée automatiquement. Sans elle, on peut quand même
# coller une URL d'image dans l'admin.
# BLOB_READ_WRITE_TOKEN=...
